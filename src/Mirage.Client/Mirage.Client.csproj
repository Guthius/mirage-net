<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <UseWpf>true</UseWpf>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Mirage</RootNamespace>
        <GenerateResourceUsePreserializedResources>True</GenerateResourceUsePreserializedResources>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <Product>Mirage</Product>
        <AssemblyVersion>3.0.0.3</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.1" />
        <PackageReference Include="SFML.Audio" Version="2.6.0" />
        <PackageReference Include="SFML.Graphics" Version="2.6.0" />
        <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mirage.Compat\Mirage.Compat.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Windows\WindowNewAccount.xaml.cs">
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Windows\WindowDeleteAccount.xaml.cs">
        <SubType>Code</SubType>
        <DependentUpon>WindowDeleteAccount.xaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <Page Update="Windows\WindowDeleteAccount.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

</Project>