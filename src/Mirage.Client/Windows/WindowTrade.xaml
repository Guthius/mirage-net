<Window x:Class="Mirage.Windows.WindowTrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trade"
        Height="250" Width="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" x:Name="lstTrade" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Padding="3" Width="80" Content="Fix Items" Margin="0,0,5,0" Click="OnFix" x:Name="picFixItems" />
            <Button Padding="3" Width="80" Content="Deal" Margin="0,0,15,0" Click="OnDeal" />
            <Button Padding="3" Width="80" Content="Cancel" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>