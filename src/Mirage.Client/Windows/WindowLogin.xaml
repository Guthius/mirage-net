<Window x:Class="Mirage.Windows.WindowLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mirage Online - Login"
        Height="210" Width="300">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter a account name and password."
                   Margin="0,0,0,20"
                   Height="50" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0" Grid.Column="0"
                Text="Name" TextAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0" />

            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Padding="3" />

            <TextBlock
                Grid.Row="2" Grid.Column="0"
                Text="Password" TextAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0" />

            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPassword" Padding="3" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Padding="3" Width="80" Content="Login" Margin="0,0,5,0" Click="OnAccept" />
            <Button Padding="3" Width="80" Content="Cancel" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>