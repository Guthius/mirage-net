<Window x:Class="Mirage.Windows.WindowChars"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mirage Online - Character Select"
        Height="250" Width="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" x:Name="lstChars" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
            <Button Padding="3" Width="80" Content="Use Char" Margin="0,0,5,0" Click="OnUse" />
            <Button Padding="3" Width="80" Content="New Char" Margin="0,0,5,0" Click="OnNew" />
            <Button Padding="3" Width="80" Content="Delete Char" Click="OnDelete" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Padding="3" Width="80" Content="Cancel" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>